# 复制为 `.env` 后填写。Vite 仅暴露以 VITE_ 开头的变量到前端。
# 行间 AI 补全：`src/features/aiInlineCompletion.ts`（自动触发停输入防抖后请求，默认 300ms）

# 可选 provider：cloud | lmstudio-fim | off
# Electron iframe 默认 cloud；独立页面配置本地 URL 时默认 lmstudio-fim，否则默认 off。
# VITE_AI_INLINE_PROVIDER=cloud

# 仅用于 lmstudio-fim：http://127.0.0.1:1234/api/v1（归一化为 POST /v1/completions）
VITE_AI_INLINE_COMPLETION_URL=

# 仅供本地 OpenAI 兼容服务联调；cloud 凭证始终由宿主持有，不能在此配置。
VITE_AI_INLINE_COMPLETION_KEY=

# 本地模型留空时默认 deepseek-coder-1.3b-base；cloud 模型由服务端选择。
VITE_AI_INLINE_COMPLETION_MODEL=

# 推理参数（请求体；top_k / repeat_penalty / gpu_offload 在 LM Studio UI 侧配置）
# VITE_AI_INLINE_TEMPERATURE=0.15
# VITE_AI_INLINE_TOP_P=0.9
# VITE_AI_INLINE_MAX_TOKENS=64

# 请求策略（默认：本地请求 8s/250ms；云端请求正常结束 500ms 后才发下一次）
# VITE_AI_INLINE_TIMEOUT_MS=8000
# VITE_AI_INLINE_MIN_REQUEST_INTERVAL_MS=500
# VITE_AI_INLINE_RATE_LIMIT_COOLDOWN_MS=30000

# 自动补全停输入多少毫秒后再请求（provider 单层尾随防抖，手动触发不等待，默认 300）
# VITE_AI_INLINE_DEBOUNCE_MS=300

# Monaco 调用 provider 前的额外合并延迟（默认 0，避免与 provider 防抖叠加）
# VITE_AI_INLINE_HOST_DEBOUNCE_MS=0

# prompt 上下文截断：prefix / suffix 最大字符数
# VITE_AI_INLINE_MAX_BEFORE_CHARS=96000
# VITE_AI_INLINE_MAX_AFTER_CHARS=32000
