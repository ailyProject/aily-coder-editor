# 复制为 `.env` 后填写。Vite 仅暴露以 VITE_ 开头的变量到前端。
# 行间 AI 补全：`src/features/aiInlineCompletion.ts`（停输入防抖后请求，默认 450ms）

# LM Studio 0.4+ 原生 REST API v1：http://127.0.0.1:1234/api/v1
# OpenAI 兼容（旧）：http://127.0.0.1:1234/v1
# FIM 模式会自动将 /api/v1 归一化为 /v1 并走 POST /v1/completions
VITE_AI_INLINE_COMPLETION_URL=

# 可选；强制 api 类型：lmstudio-v1 | openai-compat（默认按 URL 自动识别）
# VITE_AI_INLINE_API=lmstudio-v1

# 可选；LM Studio 本地服务通常留空
VITE_AI_INLINE_COMPLETION_KEY=

# 推荐 deepseek-coder-1.3b-base（FIM 用 base，不要用 instruct）
VITE_AI_INLINE_COMPLETION_MODEL=deepseek-coder-1.3b-base

# fim（默认，FIM prompt → POST /api/v1/chat 或 /v1/completions）| chat（legacy）
# VITE_AI_INLINE_MODE=fim

# 推理参数（请求体；top_k / repeat_penalty / gpu_offload 在 LM Studio UI 侧配置）
# VITE_AI_INLINE_TEMPERATURE=0.15
# VITE_AI_INLINE_TOP_P=0.9
# VITE_AI_INLINE_MAX_TOKENS=64

# 停输入多少毫秒后再请求补全（扩展内防抖，0～10000，默认 450）
# VITE_AI_INLINE_DEBOUNCE_MS=450

# 宿主在调用 provider 前的合并延迟 ms（降低 token 被取消概率，默认 900，最大 10000）
# VITE_AI_INLINE_HOST_DEBOUNCE_MS=900

# prompt 上下文截断：FIM prefix / suffix 最大字符数
# VITE_AI_INLINE_MAX_BEFORE_CHARS=3500
# VITE_AI_INLINE_MAX_AFTER_CHARS=1500

# DeepSeek Coder 原生 FIM token（一般勿改）
# VITE_AI_INLINE_FIM_BEGIN=<｜fim▁begin｜>
# VITE_AI_INLINE_FIM_HOLE=<｜fim▁hole｜>
# VITE_AI_INLINE_FIM_END=<｜fim▁end｜>

# 与上一组等价别名（任选其一）
# VITE_OPENAI_BASE_URL=
# VITE_OPENAI_API_KEY=
